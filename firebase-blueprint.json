{
  "entities": {
    "userProfile": {
      "title": "UserProfile",
      "description": "User profile and agenda preferences",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 128
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar URL",
          "maxLength": 1024
        },
        "defaultMeetEnabled": {
          "type": "boolean",
          "description": "Whether new meetings get Google Meet links by default"
        },
        "obsidianVaultName": {
          "type": "string",
          "description": "Target Obsidian vault name for URI sync",
          "maxLength": 128
        },
        "zapierWebhookUrl": {
          "type": "string",
          "description": "Custom Zapier Catch Hook URL",
          "maxLength": 1024
        },
        "notionDatabaseId": {
          "type": "string",
          "description": "Target Notion Database ID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "agendaEvent": {
      "title": "AgendaEvent",
      "description": "Scheduled events, appointments, and focus blocks",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Event unique identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of the event",
          "maxLength": 256,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Event notes and details",
          "maxLength": 2048
        },
        "startTime": {
          "type": "string",
          "description": "Start ISO datetime",
          "maxLength": 64
        },
        "endTime": {
          "type": "string",
          "description": "End ISO datetime",
          "maxLength": 64
        },
        "category": {
          "type": "string",
          "description": "Category (work, focus, meeting, personal, routine)",
          "maxLength": 64
        },
        "meetLink": {
          "type": "string",
          "description": "Google Meet conference URL",
          "maxLength": 512
        },
        "status": {
          "type": "string",
          "enum": ["scheduled", "completed", "cancelled"],
          "description": "Current status"
        },
        "isGoogleCalendar": {
          "type": "boolean",
          "description": "Synced from/to Google Calendar"
        },
        "zapierTriggered": {
          "type": "boolean",
          "description": "Whether webhook was dispatched"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "startTime", "endTime"]
    },
    "agendaTask": {
      "title": "AgendaTask",
      "description": "Actionable task or to-do item",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Task unique identifier",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "description": "Owner user UID",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Task title",
          "maxLength": 256,
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "description": "Optional details",
          "maxLength": 2048
        },
        "priority": {
          "type": "string",
          "enum": ["urgent", "high", "medium", "low"],
          "description": "Eisenhower priority"
        },
        "dueDate": {
          "type": "string",
          "description": "Due date ISO string",
          "maxLength": 64
        },
        "completed": {
          "type": "boolean",
          "description": "Task completion state"
        },
        "category": {
          "type": "string",
          "maxLength": 64
        },
        "notionSynced": {
          "type": "boolean"
        },
        "zapierTriggered": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title"]
    },
    "quickMemo": {
      "title": "QuickMemo",
      "description": "Fast thoughts, Keep notes and scratchpad ideas",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 256
        },
        "content": {
          "type": "string",
          "maxLength": 5000
        },
        "pinned": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "content"]
    },
    "syncLog": {
      "title": "SyncLog",
      "description": "Audit log for Zapier, Notion, Obsidian, and Google integrations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "service": {
          "type": "string",
          "enum": ["zapier", "obsidian", "notion", "google_meet", "google_calendar", "google_tasks"],
          "description": "Integration target"
        },
        "action": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["success", "failed", "pending"]
        },
        "payloadSummary": {
          "type": "string",
          "maxLength": 1024
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "service", "action", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "Stores user personal configuration and integration settings"
    },
    "/users/{userId}/events/{eventId}": {
      "schema": "agendaEvent",
      "description": "Scheduled events and calendar blocks for the user"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "agendaTask",
      "description": "Tasks and to-do items owned by the user"
    },
    "/users/{userId}/memos/{memoId}": {
      "schema": "quickMemo",
      "description": "Quick memos and notes owned by the user"
    },
    "/users/{userId}/syncLogs/{logId}": {
      "schema": "syncLog",
      "description": "Integration and automation audit logs"
    }
  }
}
